diff --git a/video/filter/vf_nvvfx.c b/video/filter/vf_nvvfx.c
new file mode 100644
index 0000000..0ee4444
--- /dev/null
+++ b/video/filter/vf_nvvfx.c
@@ -0,0 +1,674 @@
+/*
+ * vf_nvvfx — NVIDIA Video Effects (denoise / de-blocking) as a native mpv filter,
+ * running entirely on the GPU.
+ *
+ * Why this exists. The same effect was already reachable through VapourSynth, and measured
+ * +70.9 ms per 4K frame against a 41.71 ms budget — unusable. Isolating the layers showed that
+ * 57.7 ms of that was the host round trip mpv forces on VapourSynth (it hands scripts
+ * host-addressable planes, while the SDK wants a CUDA buffer), and only ~13 ms was the effect
+ * itself. This filter removes the round trip: frames arrive as cuda[nv12|p010] from nvdec, are
+ * converted to RGBA and back by two CUDA kernels, and leave as cuda frames. The plumbing that
+ * replaces the 57.7 ms was measured at 0.52 ms/frame by vf_cudapass, the identity filter this is
+ * built on.
+ *
+ * Deliberate differences from zhangmq/vsr-player, whose design this follows:
+ *
+ *   - Limited-range conversion divides by 219 (luma) and 224 (chroma), not by 239 for both.
+ *     The reference's arithmetic feeds the network a picture ~8.4% too dark and ~6.3%
+ *     desaturated; verified here by a round trip where black lands on 0 and white on 255.
+ *   - The requested level actually reaches the SDK. The reference always passed its upscale
+ *     quality, so its "denoise" setting changed nothing.
+ *   - The YUV kernels are precompiled to PTX and embedded, rather than compiled with NVRTC at
+ *     every start. That drops a ~97 MB runtime dependency, needs no CUDA toolkit in the
+ *     cross-build, and lets the driver JIT the PTX forward to any newer GPU.
+ *   - Output is YUV in the input's own format, not RGBA, so the frame travels the same
+ *     hwdec_cuda path decoder frames already use.
+ *
+ * HDR is refused, not degraded. The SDK was measured at roughly nine effective bits of internal
+ * precision (errors clustering on 65535/512): invisible in 8-bit SDR, not invisible in 10-bit PQ,
+ * where the code values are packed near black. An HDR frame passes through untouched.
+ *
+ * Requires cuda frames, so it needs --hwdec=nvdec and an OpenGL or Vulkan backend; mpv's CUDA
+ * interop has no D3D11 path. With the copy-back decoders it will see software frames and pass
+ * them through.
+ *
+ * This file is part of mpv.
+ *
+ * mpv is free software; you can redistribute it and/or modify it under the terms of the GNU
+ * Lesser General Public License as published by the Free Software Foundation; either version 2.1
+ * of the License, or (at your option) any later version.
+ *
+ * mpv is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even
+ * the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public License along with mpv.  If
+ * not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include <stdatomic.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <windows.h>
+
+#include <ffnvcodec/dynlink_loader.h>
+#include <libavutil/buffer.h>
+#include <libavutil/hwcontext.h>
+#include <libavutil/hwcontext_cuda.h>
+
+#include "common/common.h"
+#include "common/msg.h"
+#include "filters/filter.h"
+#include "filters/filter_internal.h"
+#include "filters/user_filters.h"
+#include "options/m_option.h"
+#include "osdep/timer.h"
+#include "video/fmt-conversion.h"
+#include "video/img_format.h"
+#include "video/mp_image.h"
+
+#include "vf_nvvfx_ptx.h"   // generated: static const char vpg_convert_ptx[]
+
+// ── NVIDIA Video Effects SDK, declared locally ────────────────────────────────
+// The SDK ships DLLs without headers, so the handful of entry points used here are declared
+// directly. Struct layout and enum values checked against the public Maxine header set.
+
+#define NVCV_RGBA   6
+#define NVCV_U8     1
+#define NVCV_CHUNKY 0
+#define NVCV_GPU    1
+
+typedef struct NvCVImage {
+    unsigned int width, height;
+    int pitch;
+    int pixelFormat, componentType;
+    unsigned char pixelBytes, componentBytes, numComponents;
+    unsigned char planar, gpuMem, colorspace;
+    void *pixels;
+    void *deletePtr;
+    void (*deleteProc)(void *);
+    unsigned long long bufferBytes;
+} NvCVImage;
+
+typedef void *NvVFX_Handle;
+typedef int (*pfn_CreateEffect)(const char *, NvVFX_Handle *);
+typedef int (*pfn_DestroyEffect)(NvVFX_Handle);
+typedef int (*pfn_SetU32)(NvVFX_Handle, const char *, unsigned int);
+typedef int (*pfn_SetImage)(NvVFX_Handle, const char *, NvCVImage *);
+typedef int (*pfn_GetImage)(NvVFX_Handle, const char *, NvCVImage *);
+typedef int (*pfn_SetCudaStream)(NvVFX_Handle, const char *, CUstream);
+typedef int (*pfn_Load)(NvVFX_Handle);
+typedef int (*pfn_Run)(NvVFX_Handle, int);
+typedef int (*pfn_ImageAlloc)(NvCVImage *, unsigned, unsigned, int, int, int, int, int);
+typedef void (*pfn_ImageDealloc)(NvCVImage *);
+
+struct sdk {
+    HMODULE vfx, nvcv;
+    pfn_CreateEffect CreateEffect;
+    pfn_DestroyEffect DestroyEffect;
+    pfn_SetU32 SetU32;
+    pfn_SetImage SetImage;
+    pfn_GetImage GetImage;
+    pfn_SetCudaStream SetCudaStream;
+    pfn_Load Load;
+    pfn_Run Run;
+    pfn_ImageAlloc ImageAlloc;
+    pfn_ImageDealloc ImageDealloc;
+};
+
+// The SDK resolves CUDA, NPP, TensorRT and its own feature libraries BY BARE NAME at Load time,
+// so the directory has to be searched then, not just when these two are opened. NVIDIA's own
+// Python loader adds the directory to the search path and pre-loads the dependencies in order;
+// this does the same.
+static const char *const k_preload[] = {
+    "nppc64_12.dll", "nppial64_12.dll", "nppicc64_12.dll", "nppidei64_12.dll",
+    "nppif64_12.dll", "nppig64_12.dll", "nppim64_12.dll", "nppist64_12.dll",
+    "nppitc64_12.dll", "nvinfer_10.dll", "nvinfer_plugin_10.dll", "nvonnxparser_10.dll",
+    "nvngxruntime.dll", "NVCVImage.dll", "NVVideoEffects.dll",
+    "nvVFXVideoSuperRes.dll", "nvngx_vsr.dll",
+};
+
+static bool sdk_load(struct mp_filter *f, struct sdk *s, const char *dir)
+{
+    wchar_t wdir[MAX_PATH];
+    if (MultiByteToWideChar(CP_UTF8, 0, dir, -1, wdir, MAX_PATH) == 0) {
+        MP_ERR(f, "nvvfx: library directory path is not usable: %s\n", dir);
+        return false;
+    }
+
+    SetDefaultDllDirectories(LOAD_LIBRARY_SEARCH_DEFAULT_DIRS);
+    if (!AddDllDirectory(wdir))
+        MP_WARN(f, "nvvfx: AddDllDirectory failed for %s (%lu)\n", dir, GetLastError());
+
+    // Belt and braces: the SDK's internal LoadLibrary calls use bare names, and not every one of
+    // them honours the added directory list.
+    {
+        DWORD n = GetEnvironmentVariableW(L"PATH", NULL, 0);
+        wchar_t *old = n ? talloc_array(NULL, wchar_t, n) : NULL;
+        if (old)
+            GetEnvironmentVariableW(L"PATH", old, n);
+        size_t len = wcslen(wdir) + (old ? wcslen(old) : 0) + 4;
+        wchar_t *np = talloc_array(NULL, wchar_t, len);
+        swprintf(np, len, L"%ls;%ls", wdir, old ? old : L"");
+        SetEnvironmentVariableW(L"PATH", np);
+        talloc_free(np);
+        talloc_free(old);
+    }
+
+    for (int i = 0; i < (int)MP_ARRAY_SIZE(k_preload); i++) {
+        char path[MAX_PATH * 2];
+        snprintf(path, sizeof(path), "%s\\%s", dir, k_preload[i]);
+        HMODULE m = LoadLibraryA(path);
+        if (!m && strstr(k_preload[i], "NVCVImage"))
+            MP_WARN(f, "nvvfx: could not preload %s\n", k_preload[i]);
+        if (m && strcmp(k_preload[i], "NVCVImage.dll") == 0)
+            s->nvcv = m;
+        if (m && strcmp(k_preload[i], "NVVideoEffects.dll") == 0)
+            s->vfx = m;
+    }
+    if (!s->nvcv || !s->vfx) {
+        MP_ERR(f, "nvvfx: NVCVImage.dll / NVVideoEffects.dll not found in %s\n", dir);
+        return false;
+    }
+
+#define SYM(mod, dst, name) do {                                                   \
+        s->dst = (void *)GetProcAddress(s->mod, name);                             \
+        if (!s->dst) { MP_ERR(f, "nvvfx: missing export %s\n", name); return false; } \
+    } while (0)
+    SYM(vfx,  CreateEffect,  "NvVFX_CreateEffect");
+    SYM(vfx,  DestroyEffect, "NvVFX_DestroyEffect");
+    SYM(vfx,  SetU32,        "NvVFX_SetU32");
+    SYM(vfx,  SetImage,      "NvVFX_SetImage");
+    SYM(vfx,  GetImage,      "NvVFX_GetImage");
+    SYM(vfx,  SetCudaStream, "NvVFX_SetCudaStream");
+    SYM(vfx,  Load,          "NvVFX_Load");
+    SYM(vfx,  Run,           "NvVFX_Run");
+    SYM(nvcv, ImageAlloc,    "NvCVImage_Alloc");
+    SYM(nvcv, ImageDealloc,  "NvCVImage_Dealloc");
+#undef SYM
+    return true;
+}
+
+// ── filter ───────────────────────────────────────────────────────────────────
+
+struct opts {
+    int quality;        // 0 = passthrough; 8..11 denoise, 12..15 de-block (SDK QualityLevel)
+    char *libdir;
+    bool sync;          // time the effect exactly, at the cost of a stall
+    int log_every;
+};
+
+struct ctx_ref {
+    CudaFunctions *cu;
+    CUcontext ctx;
+    AVBufferRef *holder;
+    atomic_int refs;
+};
+
+static void ctx_ref_release(struct ctx_ref *r)
+{
+    if (!r || atomic_fetch_sub(&r->refs, 1) != 1)
+        return;
+    av_buffer_unref(&r->holder);
+    cuda_free_functions(&r->cu);
+    free(r);
+}
+
+struct out_buf {
+    struct ctx_ref *ref;
+    CUdeviceptr mem;
+};
+
+static void free_out_buf(void *arg)
+{
+    struct out_buf *b = arg;
+    CudaFunctions *cu = b->ref->cu;
+    CUcontext dummy;
+    if (cu->cuCtxPushCurrent(b->ref->ctx) == CUDA_SUCCESS) {
+        cu->cuMemFree(b->mem);
+        cu->cuCtxPopCurrent(&dummy);
+    }
+    ctx_ref_release(b->ref);
+    free(b);
+}
+
+struct priv {
+    struct opts *opts;
+    struct sdk sdk;
+    bool sdk_ok, sdk_tried;
+
+    struct ctx_ref *ref;
+    AVBufferRef *frames_ref;
+
+    CUmodule module;
+    CUfunction k_to_rgba, k_to_yuv;
+
+    NvVFX_Handle fx;
+    NvCVImage in_img, out_img;
+    int fx_w, fx_h, fx_quality;
+    bool fx_ready;
+
+    int64_t frames_in, frames_done;
+    double ms_sum;
+    bool warned_hdr, warned_sw, warned_fmt;
+};
+
+static void fx_destroy(struct priv *p)
+{
+    if (p->fx) {
+        p->sdk.DestroyEffect(p->fx);
+        p->fx = NULL;
+    }
+    if (p->in_img.pixels)  { p->sdk.ImageDealloc(&p->in_img);  memset(&p->in_img, 0, sizeof(p->in_img)); }
+    if (p->out_img.pixels) { p->sdk.ImageDealloc(&p->out_img); memset(&p->out_img, 0, sizeof(p->out_img)); }
+    p->fx_ready = false;
+}
+
+static bool fx_ensure(struct mp_filter *f, struct priv *p, int w, int h, int quality)
+{
+    if (p->fx_ready && p->fx_w == w && p->fx_h == h) {
+        if (p->fx_quality != quality) {
+            // Changing level needs no reload: this is what makes per-scene strength possible.
+            if (p->sdk.SetU32(p->fx, "QualityLevel", (unsigned)quality) != 0) {
+                MP_WARN(f, "nvvfx: could not change QualityLevel to %d\n", quality);
+                return false;
+            }
+            p->fx_quality = quality;
+            MP_VERBOSE(f, "nvvfx: QualityLevel -> %d (no reload)\n", quality);
+        }
+        return true;
+    }
+    fx_destroy(p);
+
+    if (p->sdk.CreateEffect("VideoSuperRes", &p->fx) != 0) {
+        MP_ERR(f, "nvvfx: CreateEffect(VideoSuperRes) failed\n");
+        return false;
+    }
+    // The level is set BEFORE Load, and it is the requested one. The reference implementation
+    // always passed its upscale quality here, so its denoise setting did nothing.
+    p->sdk.SetU32(p->fx, "QualityLevel", (unsigned)quality);
+
+    if (p->sdk.ImageAlloc(&p->in_img, w, h, NVCV_RGBA, NVCV_U8, NVCV_CHUNKY, NVCV_GPU, 32) != 0 ||
+        p->sdk.ImageAlloc(&p->out_img, w, h, NVCV_RGBA, NVCV_U8, NVCV_CHUNKY, NVCV_GPU, 32) != 0) {
+        MP_ERR(f, "nvvfx: NvCVImage_Alloc %dx%d failed\n", w, h);
+        fx_destroy(p);
+        return false;
+    }
+    if (p->sdk.SetImage(p->fx, "SrcImage0", &p->in_img) != 0 ||
+        p->sdk.SetImage(p->fx, "DstImage0", &p->out_img) != 0) {
+        MP_ERR(f, "nvvfx: SetImage failed\n");
+        fx_destroy(p);
+        return false;
+    }
+    p->sdk.SetCudaStream(p->fx, "CudaStream", 0);
+    if (p->sdk.Load(p->fx) != 0) {
+        MP_ERR(f, "nvvfx: NvVFX_Load failed\n");
+        fx_destroy(p);
+        return false;
+    }
+    p->fx_w = w; p->fx_h = h; p->fx_quality = quality; p->fx_ready = true;
+    MP_INFO(f, "nvvfx: %s at %dx%d, QualityLevel %d\n",
+            quality >= 12 ? "de-blocking" : "denoise", w, h, quality);
+    return true;
+}
+
+static bool cuda_ensure(struct mp_filter *f, struct priv *p, struct mp_image *mpi)
+{
+    if (p->ref)
+        return true;
+    if (!mpi->hwctx)
+        return false;
+    AVHWFramesContext *fctx = (void *)mpi->hwctx->data;
+    if (!fctx->device_ctx || fctx->device_ctx->type != AV_HWDEVICE_TYPE_CUDA)
+        return false;
+    AVCUDADeviceContext *cd = fctx->device_ctx->hwctx;
+
+    struct ctx_ref *r = calloc(1, sizeof(*r));
+    if (!r)
+        return false;
+    if (cuda_load_functions(&r->cu, NULL) < 0) {
+        MP_ERR(f, "nvvfx: cannot load the CUDA driver library\n");
+        free(r);
+        return false;
+    }
+    r->ctx = cd->cuda_ctx;
+    r->holder = av_buffer_ref(mpi->hwctx);
+    atomic_init(&r->refs, 1);
+    p->ref = r;
+
+    CUcontext dummy;
+    if (r->cu->cuCtxPushCurrent(r->ctx) != CUDA_SUCCESS)
+        return false;
+    CUresult cr = r->cu->cuModuleLoadData(&p->module, vpg_convert_ptx);
+    if (cr == CUDA_SUCCESS)
+        cr = r->cu->cuModuleGetFunction(&p->k_to_rgba, p->module, "yuv_to_rgba");
+    if (cr == CUDA_SUCCESS)
+        cr = r->cu->cuModuleGetFunction(&p->k_to_yuv, p->module, "rgba_to_yuv");
+    r->cu->cuCtxPopCurrent(&dummy);
+    if (cr != CUDA_SUCCESS) {
+        MP_ERR(f, "nvvfx: loading the conversion kernels failed (%d)\n", cr);
+        return false;
+    }
+    MP_VERBOSE(f, "nvvfx: borrowed decoder CUDA context %p, kernels loaded\n", (void *)r->ctx);
+    return true;
+}
+
+static bool frames_ensure(struct mp_filter *f, struct priv *p, struct mp_image *mpi,
+                          enum AVPixelFormat swfmt)
+{
+    if (p->frames_ref) {
+        AVHWFramesContext *fc = (void *)p->frames_ref->data;
+        if (fc->width == mpi->w && fc->height == mpi->h && fc->sw_format == swfmt)
+            return true;
+        av_buffer_unref(&p->frames_ref);
+    }
+    AVHWFramesContext *in_fc = (void *)mpi->hwctx->data;
+    AVBufferRef *fr = av_hwframe_ctx_alloc(in_fc->device_ref);
+    if (!fr)
+        return false;
+    AVHWFramesContext *fc = (void *)fr->data;
+    fc->format = AV_PIX_FMT_CUDA;
+    fc->sw_format = swfmt;
+    fc->width = mpi->w;
+    fc->height = mpi->h;
+    if (av_hwframe_ctx_init(fr) < 0) {
+        av_buffer_unref(&fr);
+        return false;
+    }
+    p->frames_ref = fr;
+    return true;
+}
+
+// BT.709 / BT.2020 / BT.601 luma coefficients, from the frame's own tagging.
+static void matrix_coeffs(struct mp_image *mpi, float *kr, float *kb)
+{
+    switch (mpi->params.repr.sys) {
+    case PL_COLOR_SYSTEM_BT_2020_NC:
+    case PL_COLOR_SYSTEM_BT_2020_C:
+    case PL_COLOR_SYSTEM_BT_2100_PQ:
+    case PL_COLOR_SYSTEM_BT_2100_HLG:
+        *kr = 0.2627f; *kb = 0.0593f; break;
+    case PL_COLOR_SYSTEM_SMPTE_240M:
+        *kr = 0.2122f; *kb = 0.0865f; break;
+    case PL_COLOR_SYSTEM_BT_601:
+        *kr = 0.299f;  *kb = 0.114f;  break;
+    default:
+        *kr = 0.2126f; *kb = 0.0722f; break;    // BT.709
+    }
+}
+
+static void process(struct mp_filter *f)
+{
+    struct priv *p = f->priv;
+
+    if (!mp_pin_can_transfer_data(f->ppins[1], f->ppins[0]))
+        return;
+
+    struct mp_frame frame = mp_pin_out_read(f->ppins[0]);
+    if (frame.type != MP_FRAME_VIDEO) {
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+    struct mp_image *mpi = frame.data;
+    p->frames_in++;
+
+    int quality = p->opts->quality;
+    if (quality <= 0)
+        goto passthrough;
+
+    if (mpi->imgfmt != IMGFMT_CUDA) {
+        if (!p->warned_sw) {
+            MP_WARN(f, "nvvfx: input is %s, not cuda — needs --hwdec=nvdec with an OpenGL or "
+                       "Vulkan backend. Passing through.\n", mp_imgfmt_to_name(mpi->imgfmt));
+            p->warned_sw = true;
+        }
+        goto passthrough;
+    }
+    // Refuse HDR rather than quietly degrade it: the SDK carries roughly nine effective bits,
+    // which is invisible in 8-bit SDR and not invisible in 10-bit PQ.
+    if (pl_color_space_is_hdr(&mpi->params.color)) {
+        if (!p->warned_hdr) {
+            MP_INFO(f, "nvvfx: HDR input — declining (the effect is 8-bit internally). "
+                       "Passing through untouched.\n");
+            p->warned_hdr = true;
+        }
+        goto passthrough;
+    }
+    int subfmt = mpi->params.hw_subfmt;
+    if (subfmt != IMGFMT_NV12 && subfmt != IMGFMT_P010) {
+        if (!p->warned_fmt) {
+            MP_WARN(f, "nvvfx: unsupported hw format %s, passing through\n",
+                    mp_imgfmt_to_name(subfmt));
+            p->warned_fmt = true;
+        }
+        goto passthrough;
+    }
+
+    if (!p->sdk_tried) {
+        p->sdk_tried = true;
+        p->sdk_ok = sdk_load(f, &p->sdk, p->opts->libdir);
+    }
+    if (!p->sdk_ok)
+        goto passthrough;
+    if (!cuda_ensure(f, p, mpi))
+        goto passthrough;
+
+    enum AVPixelFormat swfmt = imgfmt2pixfmt(subfmt);
+    if (swfmt == AV_PIX_FMT_NONE || !frames_ensure(f, p, mpi, swfmt))
+        goto passthrough;
+
+    CudaFunctions *cu = p->ref->cu;
+    CUcontext dummy;
+    if (cu->cuCtxPushCurrent(p->ref->ctx) != CUDA_SUCCESS)
+        goto passthrough;
+
+    if (!fx_ensure(f, p, mpi->w, mpi->h, quality)) {
+        cu->cuCtxPopCurrent(&dummy);
+        goto passthrough;
+    }
+
+    // Output allocation, laid out exactly like the input's software format.
+    struct mp_image sw = {0};
+    mp_image_setfmt(&sw, subfmt);
+    mp_image_set_size(&sw, mpi->w, mpi->h);
+    int nplanes = sw.fmt.num_planes;
+    size_t rowbytes[MP_MAX_PLANES], rows[MP_MAX_PLANES], pitch[MP_MAX_PLANES];
+    size_t off[MP_MAX_PLANES], total = 0;
+    for (int n = 0; n < nplanes; n++) {
+        rowbytes[n] = (size_t)mp_image_plane_w(&sw, n) * sw.fmt.bpp[n] / 8;
+        rows[n] = mp_image_plane_h(&sw, n);
+        pitch[n] = MP_ALIGN_UP(rowbytes[n], 256);
+        off[n] = total;
+        total += pitch[n] * rows[n];
+    }
+
+    int64_t t0 = mp_time_ns();
+    CUdeviceptr mem = 0;
+    CUresult cr = cu->cuMemAlloc(&mem, total);
+    if (cr != CUDA_SUCCESS) {
+        cu->cuCtxPopCurrent(&dummy);
+        goto passthrough;
+    }
+
+    int depth16 = (subfmt == IMGFMT_P010) ? 1 : 0;
+    int limited = mpi->params.repr.levels != PL_COLOR_LEVELS_FULL;
+    float kr, kb;
+    matrix_coeffs(mpi, &kr, &kb);
+    int w = mpi->w, h = mpi->h;
+
+    void *src_y = mpi->planes[0], *src_uv = mpi->planes[1];
+    int s_yp = mpi->stride[0], s_uvp = mpi->stride[1];
+    void *rgba_in = p->in_img.pixels;
+    int rgba_pitch = p->in_img.pitch;
+
+    void *args1[] = { &src_y, &s_yp, &src_uv, &s_uvp, &rgba_in, &rgba_pitch,
+                      &w, &h, &depth16, &limited, &kr, &kb };
+    unsigned gx = (w + 15) / 16, gy = (h + 15) / 16;
+    cr = cu->cuLaunchKernel(p->k_to_rgba, gx, gy, 1, 16, 16, 1, 0, 0, args1, NULL);
+
+    if (cr == CUDA_SUCCESS && p->sdk.Run(p->fx, 0) != 0) {
+        MP_WARN(f, "nvvfx: NvVFX_Run failed; passing the frame through\n");
+        cu->cuMemFree(mem);
+        cu->cuCtxPopCurrent(&dummy);
+        goto passthrough;
+    }
+    if (cr == CUDA_SUCCESS)
+        p->sdk.GetImage(p->fx, "DstImage0", &p->out_img);
+
+    void *rgba_out = p->out_img.pixels;
+    int rgba_out_pitch = p->out_img.pitch;
+    void *dst_y = (void *)(uintptr_t)(mem + off[0]);
+    void *dst_uv = (void *)(uintptr_t)(mem + off[1]);
+    int d_yp = (int)pitch[0], d_uvp = (int)pitch[1];
+    void *args2[] = { &rgba_out, &rgba_out_pitch, &dst_y, &d_yp, &dst_uv, &d_uvp,
+                      &w, &h, &depth16, &limited, &kr, &kb };
+    if (cr == CUDA_SUCCESS)
+        cr = cu->cuLaunchKernel(p->k_to_yuv, gx, gy, 1, 16, 16, 1, 0, 0, args2, NULL);
+    if (cr == CUDA_SUCCESS && p->opts->sync)
+        cr = cu->cuStreamSynchronize(0);
+    int64_t t1 = mp_time_ns();
+
+    if (cr != CUDA_SUCCESS) {
+        const char *nm = "?";
+        cu->cuGetErrorName(cr, &nm);
+        MP_ERR(f, "nvvfx: CUDA error %s\n", nm);
+        cu->cuMemFree(mem);
+        cu->cuCtxPopCurrent(&dummy);
+        goto passthrough;
+    }
+    cu->cuCtxPopCurrent(&dummy);
+
+    struct out_buf *b = calloc(1, sizeof(*b));
+    if (!b) {
+        cu->cuCtxPushCurrent(p->ref->ctx);
+        cu->cuMemFree(mem);
+        cu->cuCtxPopCurrent(&dummy);
+        goto passthrough;
+    }
+    b->ref = p->ref;
+    b->mem = mem;
+    atomic_fetch_add(&p->ref->refs, 1);
+
+    struct mp_image tmpl = {0};
+    mp_image_sethwfmt(&tmpl, IMGFMT_CUDA, subfmt);
+    tmpl.params.hw_subfmt = subfmt;
+    mp_image_set_size(&tmpl, w, h);
+    for (int n = 0; n < nplanes; n++) {
+        tmpl.planes[n] = (uint8_t *)(uintptr_t)(mem + off[n]);
+        tmpl.stride[n] = pitch[n];
+    }
+    struct mp_image *out = mp_image_new_custom_ref(&tmpl, b, free_out_buf);
+    if (!out) {
+        free_out_buf(b);
+        goto passthrough;
+    }
+    out->hwctx = av_buffer_ref(p->frames_ref);
+    mp_image_copy_attributes(out, mpi);
+
+    p->frames_done++;
+    p->ms_sum += (double)(t1 - t0);
+    if (p->opts->log_every > 0 && p->frames_done % p->opts->log_every == 0) {
+        MP_VERBOSE(f, "nvvfx: %"PRId64" frames, QualityLevel %d, %s %dx%d, mean %.3f ms/frame%s\n",
+                   p->frames_done, p->fx_quality, mp_imgfmt_to_name(subfmt), w, h,
+                   p->ms_sum / p->frames_done / 1e6,
+                   p->opts->sync ? " (synced)" : " (async)");
+    }
+
+    mp_frame_unref(&frame);
+    mp_pin_in_write(f->ppins[1], MAKE_FRAME(MP_FRAME_VIDEO, out));
+    return;
+
+passthrough:
+    mp_pin_in_write(f->ppins[1], frame);
+}
+
+static bool command(struct mp_filter *f, struct mp_filter_command *cmd)
+{
+    struct priv *p = f->priv;
+    if (cmd->type != MP_FILTER_COMMAND_TEXT)
+        return false;
+    if (!strcmp(cmd->cmd, "quality")) {
+        int q = atoi(cmd->arg ? cmd->arg : "0");
+        if (q < 0 || q > 15)
+            return false;
+        p->opts->quality = q;      // picked up on the next frame, no graph rebuild
+        MP_INFO(f, "nvvfx: quality=%d (live)\n", q);
+        return true;
+    }
+    if (!strcmp(cmd->cmd, "stats")) {
+        MP_INFO(f, "nvvfx: in=%"PRId64" processed=%"PRId64" mean=%.3f ms\n",
+                p->frames_in, p->frames_done,
+                p->frames_done ? p->ms_sum / p->frames_done / 1e6 : 0.0);
+        return true;
+    }
+    return false;
+}
+
+static void destroy(struct mp_filter *f)
+{
+    struct priv *p = f->priv;
+    MP_VERBOSE(f, "nvvfx: destroy after %"PRId64" frames (%"PRId64" processed)\n",
+               p->frames_in, p->frames_done);
+    if (p->ref && p->ref->cu) {
+        CUcontext dummy;
+        if (p->ref->cu->cuCtxPushCurrent(p->ref->ctx) == CUDA_SUCCESS) {
+            if (p->sdk_ok)
+                fx_destroy(p);
+            if (p->module)
+                p->ref->cu->cuModuleUnload(p->module);
+            p->ref->cu->cuCtxPopCurrent(&dummy);
+        }
+    }
+    av_buffer_unref(&p->frames_ref);
+    ctx_ref_release(p->ref);
+    p->ref = NULL;
+}
+
+static const struct mp_filter_info vf_nvvfx_filter = {
+    .name = "nvvfx",
+    .priv_size = sizeof(struct priv),
+    .process = process,
+    .command = command,
+    .destroy = destroy,
+};
+
+static struct mp_filter *vf_nvvfx_create(struct mp_filter *parent, void *options)
+{
+    struct mp_filter *f = mp_filter_create(parent, &vf_nvvfx_filter);
+    if (!f) {
+        talloc_free(options);
+        return NULL;
+    }
+    struct priv *p = f->priv;
+    p->opts = talloc_steal(p, options);
+    mp_filter_add_pin(f, MP_PIN_IN, "in");
+    mp_filter_add_pin(f, MP_PIN_OUT, "out");
+    MP_VERBOSE(f, "nvvfx: created (quality=%d libdir=%s)\n", p->opts->quality, p->opts->libdir);
+    return f;
+}
+
+#define OPT_BASE_STRUCT struct opts
+static const m_option_t vf_opts_fields[] = {
+    {"quality", OPT_INT(quality), M_RANGE(0, 15)},
+    {"libdir", OPT_STRING(libdir)},
+    {"sync", OPT_BOOL(sync)},
+    {"log-every", OPT_INT(log_every), M_RANGE(0, 1000000)},
+    {0}
+};
+
+const struct mp_user_filter_entry vf_nvvfx = {
+    .desc = {
+        .description = "NVIDIA Video Effects denoise / de-blocking (GPU resident)",
+        .name = "nvvfx",
+        .priv_size = sizeof(OPT_BASE_STRUCT),
+        .priv_defaults = &(const OPT_BASE_STRUCT){
+            .quality = 0,
+            .libdir = "C:\\Apps\\mpv-ai\\Lib\\site-packages\\nvvfx\\libs",
+            .sync = false,
+            .log_every = 120,
+        },
+        .options = vf_opts_fields,
+    },
+    .create = vf_nvvfx_create,
+};
