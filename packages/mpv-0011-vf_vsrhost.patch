new file mode 100644
index 0000000000..ce88b1c515
--- /dev/null
+++ b/video/filter/vsrhost.h
@@ -0,0 +1,104 @@
+/*
+ * vsrhost.h - C ABI between mpv's vf_vsrhost and a video super-resolution host DLL (push/pull, output larger than input,
+ * multi-frame latency, EOF drain). VSH_ABI 1, 2026-10-08.
+ *
+ * Threading: every call below is made from ONE thread (mpv's filter thread) and returns without waiting on the GPU
+ * (target < 5 ms; vsh_create/vsh_destroy excepted). GPU work the caller can see (input conversion in vsh_push, output
+ * conversion in vsh_pull) is enqueued on desc.cu_stream inside desc.cu_context; the network runs on the host's own
+ * worker thread and stream. When output becomes ready the host calls desc.wakeup(desc.wakeup_opaque) from that worker
+ * thread (mpv: mp_filter_wakeup).
+ *
+ * Frame order: output frame i carries input frame i's serial (the caller maps serial -> pts/duration). After
+ * vsh_flush every pushed frame comes out, then vsh_ready() returns -1 (drained). vsh_reset drops everything
+ * pending (seek) without waiting for the GPU.
+ *
+ * Fail-open: if the network fails at run time the host switches to identity (colour conversion + bilinear scale) and
+ * keeps producing frames in order; vsh_error() then describes the failure. vsh_create fails (returns < 0) when the
+ * host cannot run at all (missing engines, unsupported format); the caller then passes video through untouched.
+ *
+ * This header is part of mpv (LGPL 2.1+). Hosts are separate programs.
+ */
+#ifndef VSRHOST_H
+#define VSRHOST_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define VSH_ABI 1
+
+enum vsh_fmt   { VSH_NV12 = 1, VSH_RGB24_TEST = 100 };   /* RGB24_TEST: packed 8-bit RGB in/out, harness only */
+enum vsh_mat   { VSH_MAT_601 = 1, VSH_MAT_709 = 2 };
+enum vsh_range { VSH_RANGE_LIMITED = 1, VSH_RANGE_FULL = 2 };
+enum vsh_log   { VSH_LOG_ERROR = 0, VSH_LOG_WARN = 1, VSH_LOG_INFO = 2, VSH_LOG_DEBUG = 3 };
+enum vsh_push_rc { VSH_OK = 0, VSH_BUSY = 1 };
+
+struct vsh_desc {
+    uint32_t abi;                    /* VSH_ABI */
+    void *cu_context;                /* CUcontext the caller's frames live in */
+    void *cu_stream;                 /* CUstream for the conversions in push/pull */
+    int in_w, in_h;                  /* input size (even) */
+    int fmt;                         /* enum vsh_fmt, input; output is NV12 BT.709 limited (RGB24 for the test format) */
+    int matrix, range;               /* input colour, enum vsh_mat / vsh_range */
+    int par_num, par_den;            /* input pixel aspect */
+    int out_w, out_h;                /* OUT: output size chosen by the host (square pixels, BT.709) */
+    int lookahead;                   /* OUT: frames held before the first output (28) */
+    const char *host_dir;            /* directory with swiftvr.conf, NULL = the DLL's own */
+    void (*log)(void *opaque, int level, const char *msg);
+    void *log_opaque;
+    void (*wakeup)(void *opaque);    /* called from the host's worker thread when vsh_ready() may have grown */
+    void *wakeup_opaque;
+    int identity;                    /* 1 = never run the network (plumbing test / forced fail-open) */
+};
+
+struct vsh_frame {
+    uintptr_t plane[2];              /* CUdeviceptr: luma, interleaved chroma (RGB24_TEST: plane[0] only) */
+    int pitch[2];                    /* bytes */
+};
+
+struct vsh_stats {                   /* diagnostics (harness, OSD) */
+    int engines_ready;               /* 1 once the engines are loaded, -1 if loading failed */
+    double load_s;                   /* create -> engines ready */
+    int chunks;                      /* chunks run since create */
+    double last_chunk_ms[4];         /* GPU ms of the last chunk: encoder, DiT, decoder, total */
+    double max_chunk_total_ms;
+    int failed;                      /* 1 = switched to identity after a run-time failure */
+    int64_t frames_in, frames_out;
+    double vram_gb;                  /* device memory the host allocated (engines + buffers) */
+};
+
+struct vsh;
+
+#ifdef VSH_HOST_BUILD
+#define VSH_EXPORT __declspec(dllexport)
+VSH_EXPORT uint32_t    vsh_abi(void);
+VSH_EXPORT int         vsh_create(struct vsh_desc *desc, struct vsh **out);          /* 0 ok; fills out_w/out_h/lookahead */
+VSH_EXPORT int         vsh_push(struct vsh *, const struct vsh_frame *in, int64_t serial); /* 0 ok, 1 BUSY (pull first), <0 error */
+VSH_EXPORT int         vsh_push_event(struct vsh *, void **cu_event);   /* CUevent: completes when the last push no longer reads its frame */
+VSH_EXPORT int         vsh_flush(struct vsh *);                         /* EOF: process what is pending */
+VSH_EXPORT int         vsh_reset(struct vsh *);                         /* seek: drop everything, start a new stream */
+VSH_EXPORT int         vsh_ready(struct vsh *);                         /* frames ready to pull; -1 = flushed and drained */
+VSH_EXPORT int         vsh_pull(struct vsh *, const struct vsh_frame *out, int64_t *serial); /* 0 ok, 1 nothing ready, <0 error */
+VSH_EXPORT int         vsh_pull_event(struct vsh *, void **cu_event);   /* CUevent: completes when the last pull's output is written */
+VSH_EXPORT int         vsh_get_stats(struct vsh *, struct vsh_stats *);
+VSH_EXPORT const char *vsh_error(struct vsh *);
+VSH_EXPORT void        vsh_destroy(struct vsh **);
+#endif
+
+typedef uint32_t    (*vsh_abi_fn)(void);
+typedef int         (*vsh_create_fn)(struct vsh_desc *, struct vsh **);
+typedef int         (*vsh_push_fn)(struct vsh *, const struct vsh_frame *, int64_t);
+typedef int         (*vsh_event_fn)(struct vsh *, void **);
+typedef int         (*vsh_simple_fn)(struct vsh *);
+typedef int         (*vsh_pull_fn)(struct vsh *, const struct vsh_frame *, int64_t *);
+typedef int         (*vsh_stats_fn)(struct vsh *, struct vsh_stats *);
+typedef const char *(*vsh_error_fn)(struct vsh *);
+typedef void        (*vsh_destroy_fn)(struct vsh **);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
