+ * License along with mpv.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include <stdatomic.h>
+#include <stdlib.h>
+#include <string.h>
+
+// dynlink_loader.h must precede hwcontext_cuda.h: it defines CUDA_VERSION,
+// which stops hwcontext_cuda.h from pulling in the toolkit's <cuda.h>.
+#include <ffnvcodec/dynlink_loader.h>
+#include <libavutil/buffer.h>
+#include <libavutil/hwcontext.h>
+#include <libavutil/hwcontext_cuda.h>
+
+#include "common/common.h"
+#include "common/msg.h"
+#include "filters/filter.h"
+#include "filters/filter_internal.h"
+#include "filters/user_filters.h"
+#include "options/m_option.h"
+#include "osdep/timer.h"
+#include "video/fmt-conversion.h"
+#include "video/img_format.h"
+#include "video/mp_image.h"
+
+struct opts {
+    bool copy;      // yes: D2D copy into an own buffer; no: pass frames untouched
+    bool sync;      // yes: wait for the copy each frame (isolates the copy cost)
+    int log_every;  // verbose statistics every N copied frames (0 = never)
+};
+
+// The decoder's CUDA context, borrowed and reference counted so that an
+// output frame can outlive the filter that produced it.
+struct ctx_ref {
+    CudaFunctions *cu;
+    CUcontext ctx;
+    AVBufferRef *holder;   // the decoder's frames ctx: keeps its device alive
+    atomic_int refs;
+};
+
+static void ctx_ref_release(struct ctx_ref *r)
+{
+    if (!r || atomic_fetch_sub(&r->refs, 1) != 1)
+        return;
+    av_buffer_unref(&r->holder);
+    cuda_free_functions(&r->cu);
+    free(r);
+}
+
+struct out_buf {
+    struct ctx_ref *ref;
+    CUdeviceptr mem;
+};
+
+static void free_out_buf(void *arg)
+{
+    struct out_buf *b = arg;
+    CudaFunctions *cu = b->ref->cu;
+    CUcontext dummy;
+    if (cu->cuCtxPushCurrent(b->ref->ctx) == CUDA_SUCCESS) {
+        cu->cuMemFree(b->mem);
+        cu->cuCtxPopCurrent(&dummy);
+    }
+    ctx_ref_release(b->ref);
+    free(b);
+}
+
+struct priv {
+    struct opts *opts;
+    struct ctx_ref *ref;
+    AVBufferRef *frames_ref;   // own CUDA frames ctx for the output frames
+    int64_t frames_in;
+    int64_t frames_copied;
+    double copy_ns_sum;
+};
+
+static bool ensure_ctx(struct mp_filter *f, struct priv *p, struct mp_image *mpi)
+{
+    if (p->ref)
+        return true;
+    if (!mpi->hwctx)
+        return false;
+    AVHWFramesContext *fctx = (void *)mpi->hwctx->data;
+    if (!fctx->device_ctx || fctx->device_ctx->type != AV_HWDEVICE_TYPE_CUDA) {
+        MP_ERR(f, "cudapass: input frames are not backed by a CUDA device\n");
+        return false;
+    }
+    AVCUDADeviceContext *cd = fctx->device_ctx->hwctx;
+
+    struct ctx_ref *r = calloc(1, sizeof(*r));
+    if (!r)
+        return false;
+    if (cuda_load_functions(&r->cu, NULL) < 0) {
+        MP_ERR(f, "cudapass: failed to load the CUDA driver library\n");
+        free(r);
+        return false;
+    }
+    r->ctx = cd->cuda_ctx;
+    r->holder = av_buffer_ref(mpi->hwctx);
+    atomic_init(&r->refs, 1);
+    p->ref = r;
+    MP_VERBOSE(f, "cudapass: borrowed decoder CUDA context %p\n", (void *)r->ctx);
+    return true;
+}
+
+// Own frames ctx on the decoder's device, same sw format as the input.
+// Recreated on size/format change.
+static bool ensure_frames(struct mp_filter *f, struct priv *p,
+                          struct mp_image *mpi, enum AVPixelFormat swfmt)
+{
+    if (p->frames_ref) {
+        AVHWFramesContext *fc = (void *)p->frames_ref->data;
+        if (fc->width == mpi->w && fc->height == mpi->h && fc->sw_format == swfmt)
+            return true;
+        av_buffer_unref(&p->frames_ref);
+    }
+    AVHWFramesContext *in_fc = (void *)mpi->hwctx->data;
+    AVBufferRef *fr = av_hwframe_ctx_alloc(in_fc->device_ref);
+    if (!fr) {
+        MP_ERR(f, "cudapass: av_hwframe_ctx_alloc failed\n");
+        return false;
+    }
+    AVHWFramesContext *fc = (void *)fr->data;
+    fc->format = AV_PIX_FMT_CUDA;
+    fc->sw_format = swfmt;
+    fc->width = mpi->w;
+    fc->height = mpi->h;
+    if (av_hwframe_ctx_init(fr) < 0) {
+        MP_ERR(f, "cudapass: av_hwframe_ctx_init failed\n");
+        av_buffer_unref(&fr);
+        return false;
+    }
+    p->frames_ref = fr;
+    MP_VERBOSE(f, "cudapass: output frames ctx %dx%d %s\n", mpi->w, mpi->h,
+               mp_imgfmt_to_name(mpi->params.hw_subfmt));
+    return true;
+}
+
+static void process(struct mp_filter *f)
+{
+    struct priv *p = f->priv;
+
+    if (!mp_pin_can_transfer_data(f->ppins[1], f->ppins[0]))
+        return;
+
+    struct mp_frame frame = mp_pin_out_read(f->ppins[0]);
+    if (frame.type != MP_FRAME_VIDEO) {
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+    struct mp_image *mpi = frame.data;
+    p->frames_in++;
+
+    if (!p->opts->copy || mpi->imgfmt != IMGFMT_CUDA) {
+        if (mpi->imgfmt != IMGFMT_CUDA && p->frames_in == 1) {
+            MP_WARN(f, "cudapass: input is %s, not cuda; passing through\n",
+                    mp_imgfmt_to_name(mpi->imgfmt));
+        }
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+
+    int subfmt = mpi->params.hw_subfmt;
+    enum AVPixelFormat swfmt = imgfmt2pixfmt(subfmt);
+    if (swfmt == AV_PIX_FMT_NONE) {
+        MP_ERR(f, "cudapass: unsupported hw_subfmt %s\n", mp_imgfmt_to_name(subfmt));
+        goto fail;
+    }
+    if (!ensure_ctx(f, p, mpi) || !ensure_frames(f, p, mpi, swfmt))
+        goto fail;
+    CudaFunctions *cu = p->ref->cu;
+
+    // Plane geometry comes from the software format the hw frame wraps.
+    struct mp_image sw = {0};
+    mp_image_setfmt(&sw, subfmt);
+    mp_image_set_size(&sw, mpi->w, mpi->h);
+    int nplanes = sw.fmt.num_planes;
+    size_t rowbytes[MP_MAX_PLANES], rows[MP_MAX_PLANES], pitch[MP_MAX_PLANES];
+    size_t off[MP_MAX_PLANES], total = 0;
+    for (int n = 0; n < nplanes; n++) {
+        rowbytes[n] = (size_t)mp_image_plane_w(&sw, n) * sw.fmt.bpp[n] / 8;
+        rows[n] = mp_image_plane_h(&sw, n);
+        pitch[n] = MP_ALIGN_UP(rowbytes[n], 256);
+        off[n] = total;
+        total += pitch[n] * rows[n];
+    }
+
+    CUcontext dummy;
+    if (cu->cuCtxPushCurrent(p->ref->ctx) != CUDA_SUCCESS) {
+        MP_ERR(f, "cudapass: cuCtxPushCurrent failed\n");
+        goto fail;
+    }
+
+    // Stream 0 (legacy default) is ordered after the decoder's blocking
+    // device stream, and it is the stream hwdec_cuda maps frames on.
+    int64_t t0 = mp_time_ns();
+    CUdeviceptr mem = 0;
+    CUresult cr = cu->cuMemAlloc(&mem, total);
+    for (int n = 0; cr == CUDA_SUCCESS && n < nplanes; n++) {
+        CUDA_MEMCPY2D cpy = {
+            .srcMemoryType = CU_MEMORYTYPE_DEVICE,
+            .srcDevice     = (CUdeviceptr)(uintptr_t)mpi->planes[n],
+            .srcPitch      = mpi->stride[n],
+            .dstMemoryType = CU_MEMORYTYPE_DEVICE,
+            .dstDevice     = mem + off[n],
+            .dstPitch      = pitch[n],
+            .WidthInBytes  = rowbytes[n],
+            .Height        = rows[n],
+        };
+        cr = cu->cuMemcpy2DAsync(&cpy, 0);
+    }
+    if (cr == CUDA_SUCCESS && p->opts->sync)
+        cr = cu->cuStreamSynchronize(0);
+    int64_t t1 = mp_time_ns();
+
+    if (cr != CUDA_SUCCESS) {
+        const char *name = "?";
+        cu->cuGetErrorName(cr, &name);
+        MP_ERR(f, "cudapass: CUDA error %s during copy\n", name);
+        if (mem)
+            cu->cuMemFree(mem);
+        cu->cuCtxPopCurrent(&dummy);
+        goto fail;
+    }
+    cu->cuCtxPopCurrent(&dummy);
+
+    struct out_buf *b = calloc(1, sizeof(*b));
+    if (!b) {
+        cu->cuCtxPushCurrent(p->ref->ctx);
+        cu->cuMemFree(mem);
+        cu->cuCtxPopCurrent(&dummy);
+        goto fail;
+    }
+    b->ref = p->ref;
+    b->mem = mem;
+    atomic_fetch_add(&p->ref->refs, 1);
+
+    struct mp_image tmpl = {0};
+    mp_image_sethwfmt(&tmpl, IMGFMT_CUDA, subfmt);
+    tmpl.params.hw_subfmt = subfmt;
+    mp_image_set_size(&tmpl, mpi->w, mpi->h);
+    for (int n = 0; n < nplanes; n++) {
+        tmpl.planes[n] = (uint8_t *)(uintptr_t)(mem + off[n]);
+        tmpl.stride[n] = pitch[n];
+    }
+    struct mp_image *out = mp_image_new_custom_ref(&tmpl, b, free_out_buf);
+    if (!out) {
+        free_out_buf(b);
+        goto fail;
+    }
+    out->hwctx = av_buffer_ref(p->frames_ref);
+    mp_image_copy_attributes(out, mpi);
+
+    p->frames_copied++;
+    p->copy_ns_sum += (double)(t1 - t0);
+    if (p->opts->log_every > 0 && p->frames_copied % p->opts->log_every == 0) {
+        MP_VERBOSE(f, "cudapass: %"PRId64" frames copied (%s %dx%d, %d planes, "
+                   "%zu bytes), mean %.3f ms/frame%s\n",
+                   p->frames_copied, mp_imgfmt_to_name(subfmt), mpi->w, mpi->h,
+                   nplanes, total,
+                   p->copy_ns_sum / p->frames_copied / 1e6,
+                   p->opts->sync ? " (synced)" : " (async, enqueue only)");
+    }
+
+    mp_frame_unref(&frame);
+    mp_pin_in_write(f->ppins[1], MAKE_FRAME(MP_FRAME_VIDEO, out));
+    return;
+
+fail:
+    mp_frame_unref(&frame);
+    mp_filter_internal_mark_failed(f);
+}
+
+static bool command(struct mp_filter *f, struct mp_filter_command *cmd)
+{
+    struct priv *p = f->priv;
+    if (cmd->type != MP_FILTER_COMMAND_TEXT)
+        return false;
+    const char *arg = cmd->arg ? cmd->arg : "";
+    bool on = !strcmp(arg, "yes") || !strcmp(arg, "1") || !strcmp(arg, "on");
+    if (!strcmp(cmd->cmd, "copy")) {
+        p->opts->copy = on;
+    } else if (!strcmp(cmd->cmd, "sync")) {
+        p->opts->sync = on;
+    } else if (!strcmp(cmd->cmd, "stats")) {
+        MP_INFO(f, "cudapass: in=%"PRId64" copied=%"PRId64" mean=%.3f ms\n",
+                p->frames_in, p->frames_copied,
+                p->frames_copied ? p->copy_ns_sum / p->frames_copied / 1e6 : 0.0);
+        return true;
+    } else {
+        return false;
+    }
+    MP_INFO(f, "cudapass: %s=%s (live, no chain rebuild)\n", cmd->cmd,
+            on ? "yes" : "no");
+    return true;
+}
+
+static void destroy(struct mp_filter *f)
+{
+    struct priv *p = f->priv;
+    MP_VERBOSE(f, "cudapass: destroy after %"PRId64" frames (%"PRId64" copied)\n",
+               p->frames_in, p->frames_copied);
+    av_buffer_unref(&p->frames_ref);
+    ctx_ref_release(p->ref);
+    p->ref = NULL;
+}
+
+static const struct mp_filter_info vf_cudapass_filter = {
+    .name = "cudapass",
+    .priv_size = sizeof(struct priv),
+    .process = process,
+    .command = command,
+    .destroy = destroy,
+};
+
+static struct mp_filter *vf_cudapass_create(struct mp_filter *parent, void *options)
+{
+    struct mp_filter *f = mp_filter_create(parent, &vf_cudapass_filter);
+    if (!f) {
+        talloc_free(options);
+        return NULL;
+    }
+    struct priv *p = f->priv;
+    p->opts = talloc_steal(p, options);
+    mp_filter_add_pin(f, MP_PIN_IN, "in");
+    mp_filter_add_pin(f, MP_PIN_OUT, "out");
+    MP_VERBOSE(f, "cudapass: created (copy=%s sync=%s)\n",
+               p->opts->copy ? "yes" : "no", p->opts->sync ? "yes" : "no");
+    return f;
+}
+
+#define OPT_BASE_STRUCT struct opts
+static const m_option_t vf_opts_fields[] = {
+    {"copy", OPT_BOOL(copy)},
+    {"sync", OPT_BOOL(sync)},
+    {"log-every", OPT_INT(log_every), M_RANGE(0, 1000000)},
+    {0}
+};
+
+const struct mp_user_filter_entry vf_cudapass = {
+    .desc = {
+        .description = "identity CUDA filter (device-to-device copy)",
+        .name = "cudapass",
+        .priv_size = sizeof(OPT_BASE_STRUCT),
+        .priv_defaults = &(const OPT_BASE_STRUCT){
+            .copy = true,
+            .sync = false,
+            .log_every = 120,
+        },
+        .options = vf_opts_fields,
+    },
+    .create = vf_cudapass_create,
+};
