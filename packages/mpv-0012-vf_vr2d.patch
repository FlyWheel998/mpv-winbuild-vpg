--- /dev/null
+++ b/video/filter/vf_vr2d.c
@@ -0,0 +1,522 @@
+/*
+ * vf_vr2d: VR180 / VR360 -> flat view, GPU resident (CUDA)
+ *
+ * One eye of a stereo VR frame is reprojected through a virtual pinhole
+ * camera into an ordinary flat picture, in CUDA memory, before any
+ * upscaler. The point of doing it here rather than in a render shader:
+ * an upscaler placed after this filter (vf_nvvfx VSR) then spends all its
+ * work on the part of the frame that is actually on screen, at the
+ * source's own pixel density, instead of enlarging both whole eyes.
+ *
+ * Geometry is that of portable_config/shaders/vr2d.glsl; the kernels
+ * are precompiled and embedded like vf_nvvfx's, and were checked against
+ * ffmpeg's v360 before embedding (45.9-48.4 dB luma over six views and two
+ * projections).
+ *
+ * Input: cuda[nv12|p010] from nvdec. Anything else passes through with one
+ * warning (the render-shader path covers software decoding).
+ * Output: cuda frame of the same format at w x h (default 1920x1080).
+ *
+ * Live, no chain rebuild:
+ *   vf-command <label> view <yaw>,<pitch>,<fov>    (degrees; one call per drag step)
+ *   vf-command <label> yaw|pitch|fov|span|lens <deg>
+ *   vf-command <label> eye|stereo|proj <n>
+ *   vf-command <label> enable <yes|no>
+ *
+ * This file is part of mpv.
+ *
+ * mpv is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * mpv is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with mpv.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include <math.h>
+#include <stdio.h>
+#include <stdatomic.h>
+#include <stdlib.h>
+#include <string.h>
+
+// dynlink_loader.h must precede hwcontext_cuda.h: it defines CUDA_VERSION,
+// which stops hwcontext_cuda.h from pulling in the toolkit's <cuda.h>.
+#include <ffnvcodec/dynlink_loader.h>
+#include <libavutil/buffer.h>
+#include <libavutil/hwcontext.h>
+#include <libavutil/hwcontext_cuda.h>
+
+#include "common/common.h"
+#include "common/msg.h"
+#include "filters/filter.h"
+#include "filters/filter_internal.h"
+#include "filters/user_filters.h"
+#include "options/m_option.h"
+#include "osdep/timer.h"
+#include "video/fmt-conversion.h"
+#include "video/img_format.h"
+#include "video/mp_image.h"
+
+#include "vf_vr2d_ptx.h"   // generated: static const char vpg_vr2d_ptx[]
+
+struct opts {
+    bool enable;
+    int w, h;
+    int stereo;     // 0 mono, 1 side-by-side, 2 top-bottom
+    int proj;       // 0 equirectangular, 1 equidistant fisheye
+    float span;     // equirect horizontal coverage, degrees
+    float lens;     // fisheye coverage, degrees
+    float yaw, pitch, fov;
+    int eye;        // 0 left/top, 1 right/bottom
+    int log_every;
+};
+
+// Must match the kernels' struct VrView (passed by value as one kernel argument).
+struct vr_view {
+    float cy, sy, cp, sp;
+    float tan_h, tan_v;
+    float span, lens;
+    int proj;
+    float ex0, ey0, ew, eh;
+};
+
+// The decoder's CUDA context, borrowed and reference counted so that an
+// output frame can outlive the filter that produced it (as vf_cudapass).
+struct ctx_ref {
+    CudaFunctions *cu;
+    CUcontext ctx;
+    AVBufferRef *holder;
+    atomic_int refs;
+};
+
+static void ctx_ref_release(struct ctx_ref *r)
+{
+    if (!r || atomic_fetch_sub(&r->refs, 1) != 1)
+        return;
+    av_buffer_unref(&r->holder);
+    cuda_free_functions(&r->cu);
+    free(r);
+}
+
+struct out_buf {
+    struct ctx_ref *ref;
+    CUdeviceptr mem;
+};
+
+static void free_out_buf(void *arg)
+{
+    struct out_buf *b = arg;
+    CudaFunctions *cu = b->ref->cu;
+    CUcontext dummy;
+    if (cu->cuCtxPushCurrent(b->ref->ctx) == CUDA_SUCCESS) {
+        cu->cuMemFree(b->mem);
+        cu->cuCtxPopCurrent(&dummy);
+    }
+    ctx_ref_release(b->ref);
+    free(b);
+}
+
+struct priv {
+    struct opts *opts;
+    struct ctx_ref *ref;
+    CUmodule module;
+    CUfunction k_luma8, k_chroma8, k_luma16, k_chroma16;
+    AVBufferRef *frames_ref;
+    bool failed;            // kernels could not be loaded: pass through for good
+    bool warned_sw, warned_fmt;
+    int64_t frames_in, frames_done;
+    double ms_sum;
+};
+
+static bool cuda_ensure(struct mp_filter *f, struct priv *p, struct mp_image *mpi)
+{
+    if (p->ref)
+        return true;
+    if (!mpi->hwctx)
+        return false;
+    AVHWFramesContext *fctx = (void *)mpi->hwctx->data;
+    if (!fctx->device_ctx || fctx->device_ctx->type != AV_HWDEVICE_TYPE_CUDA)
+        return false;
+    AVCUDADeviceContext *cd = fctx->device_ctx->hwctx;
+
+    struct ctx_ref *r = calloc(1, sizeof(*r));
+    if (!r)
+        return false;
+    if (cuda_load_functions(&r->cu, NULL) < 0) {
+        MP_ERR(f, "vr2d: cannot load the CUDA driver library\n");
+        free(r);
+        return false;
+    }
+    r->ctx = cd->cuda_ctx;
+    r->holder = av_buffer_ref(mpi->hwctx);
+    atomic_init(&r->refs, 1);
+    p->ref = r;
+
+    CUcontext dummy;
+    if (r->cu->cuCtxPushCurrent(r->ctx) != CUDA_SUCCESS)
+        return false;
+    CUresult cr = r->cu->cuModuleLoadData(&p->module, vpg_vr2d_ptx);
+    if (cr == CUDA_SUCCESS)
+        cr = r->cu->cuModuleGetFunction(&p->k_luma8, p->module, "vr2d_luma8");
+    if (cr == CUDA_SUCCESS)
+        cr = r->cu->cuModuleGetFunction(&p->k_chroma8, p->module, "vr2d_chroma8");
+    if (cr == CUDA_SUCCESS)
+        cr = r->cu->cuModuleGetFunction(&p->k_luma16, p->module, "vr2d_luma16");
+    if (cr == CUDA_SUCCESS)
+        cr = r->cu->cuModuleGetFunction(&p->k_chroma16, p->module, "vr2d_chroma16");
+    r->cu->cuCtxPopCurrent(&dummy);
+    if (cr != CUDA_SUCCESS) {
+        MP_ERR(f, "vr2d: loading the kernels failed (%d) - playing the original picture\n", cr);
+        p->failed = true;
+        return false;
+    }
+    MP_VERBOSE(f, "vr2d: borrowed decoder CUDA context %p, kernels loaded\n", (void *)r->ctx);
+    return true;
+}
+
+static bool frames_ensure(struct priv *p, struct mp_image *mpi, int w, int h,
+                          enum AVPixelFormat swfmt)
+{
+    if (p->frames_ref) {
+        AVHWFramesContext *fc = (void *)p->frames_ref->data;
+        if (fc->width == w && fc->height == h && fc->sw_format == swfmt)
+            return true;
+        av_buffer_unref(&p->frames_ref);
+    }
+    AVHWFramesContext *in_fc = (void *)mpi->hwctx->data;
+    AVBufferRef *fr = av_hwframe_ctx_alloc(in_fc->device_ref);
+    if (!fr)
+        return false;
+    AVHWFramesContext *fc = (void *)fr->data;
+    fc->format = AV_PIX_FMT_CUDA;
+    fc->sw_format = swfmt;
+    fc->width = w;
+    fc->height = h;
+    if (av_hwframe_ctx_init(fr) < 0) {
+        av_buffer_unref(&fr);
+        return false;
+    }
+    p->frames_ref = fr;
+    return true;
+}
+
+static struct vr_view make_view(const struct opts *o, int sw, int sh, int ow, int oh)
+{
+    struct vr_view v = {0};
+    double yaw = o->yaw * M_PI / 180, pitch = o->pitch * M_PI / 180;
+    double th = tan(o->fov * M_PI / 180 / 2);
+    v.cy = cos(yaw);
+    v.sy = sin(yaw);
+    v.cp = cos(pitch);
+    v.sp = sin(pitch);
+    v.tan_h = th;
+    v.tan_v = th * oh / ow;
+    v.span = o->span * M_PI / 180;
+    v.lens = o->lens * M_PI / 180;
+    v.proj = o->proj;
+    v.ex0 = 0;
+    v.ey0 = 0;
+    v.ew = sw;
+    v.eh = sh;
+    if (o->stereo == 1) {
+        v.ew = sw / 2;
+        v.ex0 = o->eye * v.ew;
+    } else if (o->stereo == 2) {
+        v.eh = sh / 2;
+        v.ey0 = o->eye * v.eh;
+    }
+    return v;
+}
+
+static void process(struct mp_filter *f)
+{
+    struct priv *p = f->priv;
+
+    if (!mp_pin_can_transfer_data(f->ppins[1], f->ppins[0]))
+        return;
+
+    struct mp_frame frame = mp_pin_out_read(f->ppins[0]);
+    if (frame.type != MP_FRAME_VIDEO) {
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+    struct mp_image *mpi = frame.data;
+    p->frames_in++;
+
+    const struct opts *o = p->opts;
+    if (!o->enable || p->failed)
+        goto passthrough;
+    if (mpi->imgfmt != IMGFMT_CUDA) {
+        if (!p->warned_sw) {
+            MP_WARN(f, "vr2d: input is %s, not cuda - needs --hwdec=nvdec. Passing through.\n",
+                    mp_imgfmt_to_name(mpi->imgfmt));
+            p->warned_sw = true;
+        }
+        goto passthrough;
+    }
+    int subfmt = mpi->params.hw_subfmt;
+    if (subfmt != IMGFMT_NV12 && subfmt != IMGFMT_P010) {
+        if (!p->warned_fmt) {
+            MP_WARN(f, "vr2d: unsupported hw format %s, passing through\n",
+                    mp_imgfmt_to_name(subfmt));
+            p->warned_fmt = true;
+        }
+        goto passthrough;
+    }
+    if (!cuda_ensure(f, p, mpi))
+        goto passthrough;
+
+    int ow = o->w & ~1, oh = o->h & ~1;
+    enum AVPixelFormat swfmt = imgfmt2pixfmt(subfmt);
+    if (swfmt == AV_PIX_FMT_NONE || !frames_ensure(p, mpi, ow, oh, swfmt))
+        goto passthrough;
+
+    CudaFunctions *cu = p->ref->cu;
+    CUcontext dummy;
+    if (cu->cuCtxPushCurrent(p->ref->ctx) != CUDA_SUCCESS)
+        goto passthrough;
+
+    // Output allocation, laid out exactly like the output software format.
+    struct mp_image sw = {0};
+    mp_image_setfmt(&sw, subfmt);
+    mp_image_set_size(&sw, ow, oh);
+    int nplanes = sw.fmt.num_planes;
+    size_t pitch[MP_MAX_PLANES], off[MP_MAX_PLANES], total = 0;
+    for (int n = 0; n < nplanes; n++) {
+        size_t rowbytes = (size_t)mp_image_plane_w(&sw, n) * sw.fmt.bpp[n] / 8;
+        pitch[n] = MP_ALIGN_UP(rowbytes, 256);
+        off[n] = total;
+        total += pitch[n] * mp_image_plane_h(&sw, n);
+    }
+
+    int64_t t0 = mp_time_ns();
+    CUdeviceptr mem = 0;
+    CUresult cr = cu->cuMemAlloc(&mem, total);
+    if (cr != CUDA_SUCCESS) {
+        cu->cuCtxPopCurrent(&dummy);
+        goto passthrough;
+    }
+
+    struct vr_view v = make_view(o, mpi->w, mpi->h, ow, oh);
+    bool b16 = subfmt == IMGFMT_P010;
+    void *src_y = mpi->planes[0], *src_uv = mpi->planes[1];
+    int s_yp = mpi->stride[0], s_uvp = mpi->stride[1];
+    void *dst_y = (void *)(uintptr_t)(mem + off[0]);
+    void *dst_uv = (void *)(uintptr_t)(mem + off[1]);
+    int d_yp = (int)pitch[0], d_uvp = (int)pitch[1];
+    void *args_y[] = { &src_y, &s_yp, &dst_y, &d_yp, &ow, &oh, &v };
+    void *args_uv[] = { &src_uv, &s_uvp, &dst_uv, &d_uvp, &ow, &oh, &v };
+    int cw = (ow + 1) / 2, ch = (oh + 1) / 2;
+
+    // Stream 0 (legacy default) is ordered after the decoder's blocking stream,
+    // and it is the stream hwdec_cuda maps frames on (as vf_cudapass / vf_nvvfx).
+    cr = cu->cuLaunchKernel(b16 ? p->k_luma16 : p->k_luma8, (ow + 15) / 16, (oh + 15) / 16, 1,
+                            16, 16, 1, 0, 0, args_y, NULL);
+    if (cr == CUDA_SUCCESS)
+        cr = cu->cuLaunchKernel(b16 ? p->k_chroma16 : p->k_chroma8, (cw + 15) / 16,
+                                (ch + 15) / 16, 1, 16, 16, 1, 0, 0, args_uv, NULL);
+    int64_t t1 = mp_time_ns();
+    if (cr != CUDA_SUCCESS) {
+        const char *nm = "?";
+        cu->cuGetErrorName(cr, &nm);
+        MP_ERR(f, "vr2d: CUDA error %s\n", nm);
+        cu->cuMemFree(mem);
+        cu->cuCtxPopCurrent(&dummy);
+        goto passthrough;
+    }
+    cu->cuCtxPopCurrent(&dummy);
+
+    struct out_buf *b = calloc(1, sizeof(*b));
+    if (!b) {
+        cu->cuCtxPushCurrent(p->ref->ctx);
+        cu->cuMemFree(mem);
+        cu->cuCtxPopCurrent(&dummy);
+        goto passthrough;
+    }
+    b->ref = p->ref;
+    b->mem = mem;
+    atomic_fetch_add(&p->ref->refs, 1);
+
+    struct mp_image tmpl = {0};
+    mp_image_sethwfmt(&tmpl, IMGFMT_CUDA, subfmt);
+    tmpl.params.hw_subfmt = subfmt;
+    mp_image_set_size(&tmpl, ow, oh);
+    for (int n = 0; n < nplanes; n++) {
+        tmpl.planes[n] = (uint8_t *)(uintptr_t)(mem + off[n]);
+        tmpl.stride[n] = pitch[n];
+    }
+    struct mp_image *out = mp_image_new_custom_ref(&tmpl, b, free_out_buf);
+    if (!out) {
+        free_out_buf(b);
+        goto passthrough;
+    }
+    out->hwctx = av_buffer_ref(p->frames_ref);
+    mp_image_copy_attributes(out, mpi);
+    // copy_attributes carries the source's crop and pixel aspect; the view is
+    // its own picture with square pixels.
+    out->params.crop = (struct mp_rect){0, 0, ow, oh};
+    out->params.p_w = out->params.p_h = 1;
+
+    p->frames_done++;
+    p->ms_sum += (double)(t1 - t0);
+    if (o->log_every > 0 && p->frames_done % o->log_every == 0) {
+        MP_VERBOSE(f, "vr2d: %"PRId64" frames, %s %dx%d -> %dx%d, view %.1f/%.1f/%.1f eye %d, "
+                   "mean enqueue %.3f ms\n", p->frames_done, mp_imgfmt_to_name(subfmt),
+                   mpi->w, mpi->h, ow, oh, o->yaw, o->pitch, o->fov, o->eye,
+                   p->ms_sum / p->frames_done / 1e6);
+    }
+
+    mp_frame_unref(&frame);
+    mp_pin_in_write(f->ppins[1], MAKE_FRAME(MP_FRAME_VIDEO, out));
+    return;
+
+passthrough:
+    mp_pin_in_write(f->ppins[1], frame);
+}
+
+static bool set_float(struct mp_filter *f, float *dst, const char *arg, float lo, float hi)
+{
+    char *end = NULL;
+    double v = strtod(arg, &end);
+    if (end == arg || !isfinite(v)) {
+        MP_WARN(f, "vr2d: bad number '%s'\n", arg);
+        return false;
+    }
+    *dst = MPCLAMP(v, lo, hi);
+    return true;
+}
+
+static bool set_int(struct mp_filter *f, int *dst, const char *arg, int lo, int hi)
+{
+    float v;
+    if (!set_float(f, &v, arg, lo, hi))
+        return false;
+    *dst = (int)lrintf(v);
+    return true;
+}
+
+static bool command(struct mp_filter *f, struct mp_filter_command *cmd)
+{
+    struct priv *p = f->priv;
+    struct opts *o = p->opts;
+    if (cmd->type != MP_FILTER_COMMAND_TEXT || !cmd->cmd)
+        return false;
+    const char *c = cmd->cmd, *arg = cmd->arg ? cmd->arg : "";
+    bool ok;
+    if (!strcmp(c, "view")) {
+        float y, pt, fv;
+        ok = sscanf(arg, "%f,%f,%f", &y, &pt, &fv) == 3 && isfinite(y) && isfinite(pt) && isfinite(fv);
+        if (ok) {
+            o->yaw = MPCLAMP(y, -360, 360);
+            o->pitch = MPCLAMP(pt, -90, 90);
+            o->fov = MPCLAMP(fv, 10, 170);
+        }
+    } else if (!strcmp(c, "yaw")) {
+        ok = set_float(f, &o->yaw, arg, -360, 360);
+    } else if (!strcmp(c, "pitch")) {
+        ok = set_float(f, &o->pitch, arg, -90, 90);
+    } else if (!strcmp(c, "fov")) {
+        ok = set_float(f, &o->fov, arg, 10, 170);
+    } else if (!strcmp(c, "span")) {
+        ok = set_float(f, &o->span, arg, 90, 360);
+    } else if (!strcmp(c, "lens")) {
+        ok = set_float(f, &o->lens, arg, 120, 250);
+    } else if (!strcmp(c, "eye")) {
+        ok = set_int(f, &o->eye, arg, 0, 1);
+    } else if (!strcmp(c, "stereo")) {
+        ok = set_int(f, &o->stereo, arg, 0, 2);
+    } else if (!strcmp(c, "proj")) {
+        ok = set_int(f, &o->proj, arg, 0, 1);
+    } else if (!strcmp(c, "enable")) {
+        o->enable = !strcmp(arg, "yes") || !strcmp(arg, "1") || !strcmp(arg, "on");
+        ok = true;
+    } else {
+        return false;
+    }
+    if (ok)
+        mp_filter_wakeup(f);
+    return ok;
+}
+
+static void destroy(struct mp_filter *f)
+{
+    struct priv *p = f->priv;
+    MP_VERBOSE(f, "vr2d: destroy after %"PRId64" frames (%"PRId64" reprojected)\n",
+               p->frames_in, p->frames_done);
+    if (p->module && p->ref) {
+        CUcontext dummy;
+        if (p->ref->cu->cuCtxPushCurrent(p->ref->ctx) == CUDA_SUCCESS) {
+            p->ref->cu->cuModuleUnload(p->module);
+            p->ref->cu->cuCtxPopCurrent(&dummy);
+        }
+    }
+    av_buffer_unref(&p->frames_ref);
+    ctx_ref_release(p->ref);
+    p->ref = NULL;
+}
+
+static const struct mp_filter_info vf_vr2d_filter = {
+    .name = "vr2d",
+    .priv_size = sizeof(struct priv),
+    .process = process,
+    .command = command,
+    .destroy = destroy,
+};
+
+static struct mp_filter *vf_vr2d_create(struct mp_filter *parent, void *options)
+{
+    struct mp_filter *f = mp_filter_create(parent, &vf_vr2d_filter);
+    if (!f) {
+        talloc_free(options);
+        return NULL;
+    }
+    struct priv *p = f->priv;
+    p->opts = talloc_steal(p, options);
+    mp_filter_add_pin(f, MP_PIN_IN, "in");
+    mp_filter_add_pin(f, MP_PIN_OUT, "out");
+    return f;
+}
+
+#define OPT_BASE_STRUCT struct opts
+static const m_option_t vf_opts_fields[] = {
+    {"enable", OPT_BOOL(enable)},
+    {"w", OPT_INT(w), M_RANGE(64, 8192)},
+    {"h", OPT_INT(h), M_RANGE(64, 8192)},
+    {"stereo", OPT_CHOICE(stereo, {"mono", 0}, {"sbs", 1}, {"tb", 2})},
