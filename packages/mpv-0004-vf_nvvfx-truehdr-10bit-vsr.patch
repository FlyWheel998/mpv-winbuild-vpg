+
+// Apply the settings that change without a reload: VSR level/strength, TrueHDR tunables.
+static bool fx_apply_live(struct mp_filter *f, struct priv *p, int quality)
+{
+    if (p->fx_effect == EFFECT_TRUEHDR) {
+        static const char *const names[5] = {"Contrast", "Saturation", "MiddleGray", "Luminance",
+                                             "DebandingOff"};
+        int t[5];
+        truehdr_tunables(p->opts, t);
+        for (int n = 0; n < 5; n++) {
+            if (t[n] == p->fx_tun[n])
+                continue;
+            if (p->sdk.SetU32(p->fx, names[n], (unsigned)t[n]) != 0) {
+                MP_WARN(f, "nvvfx: TrueHDR %s=%d refused\n", names[n], t[n]);
                 return false;
             }
-            p->fx_quality = quality;
