From 0930e1ae5f271b077e3f80452581d6b18ca5eb8c Mon Sep 17 00:00:00 2001
From: VideoPlayerGold <127964164+FlyWheel998@users.noreply.github.com>
Date: Sat, 3 Oct 2026 18:26:19 -0400
Subject: [PATCH] vf_nvvfx: TrueHDR, 10-bit RGB10A2 VSR path, quality to 23,
 strength, scale=2

Moves the filter to the VFX SDK 1.3.0 runtime (TrueHDR needs it) and adds:
 - effect=truehdr: SDR -> HDR10 on the GPU. RGBA8 in, RGB10A2 BT.2020/PQ out, converted to
   limited-range P010 and tagged BT.2020/PQ with max_luma = the luminance given to the network.
 - encoding=10: VSR on RGB10A2. Accepts HDR (the 8-bit path still declines it).
 - quality 0-23 (HighBitrate 16-19, Streaming 21/23), strength 0..1, scale=2 for levels 1-4.
 - live vf-commands for quality, strength, enable and every TrueHDR tunable.
NvCVImage RGB10A2/P32 = 13/11, probed from NVCVImage.dll 1.3.0.
---
 video/filter/vf_nvvfx.c     |  390 ++++++++--
 video/filter/vf_nvvfx_ptx.h | 1332 +++++++++++++++++++++++------------
 2 files changed, 1216 insertions(+), 506 deletions(-)

diff --git a/video/filter/vf_nvvfx.c b/video/filter/vf_nvvfx.c
index 0ee4444..f7d0a98 100644
--- a/video/filter/vf_nvvfx.c
+++ b/video/filter/vf_nvvfx.c
@@ -28,6 +28,15 @@
  * precision (errors clustering on 65535/512): invisible in 8-bit SDR, not invisible in 10-bit PQ,
  * where the code values are packed near black. An HDR frame passes through untouched.
  *
+ * Revision 2 (2026-10-03, PLAN_nvidia_ai_filters Stage A1) adds, on the VFX SDK 1.3.0 runtime:
+ *   - effect=truehdr : NVIDIA TrueHDR (SDR -> HDR10). Takes 8-bit RGBA, returns packed RGB10A2 in
+ *     BT.2020 / PQ; converted here to limited-range P010 and tagged like an HDR10 disc, with the
+ *     mastering peak set to the luminance asked of the network, not a guessed 1000 nits.
+ *   - encoding=10 for effect=vsr : the 10-bit RGB10A2 path. It removes the 8-bit quantisation that
+ *     made HDR unsafe (F-R384), so HDR is accepted on this path; the 8-bit path still declines it.
+ *   - quality up to 23 (HighBitrate 16-19, Streaming 21/23), strength, and scale=2 for the VSR
+ *     upscale levels 1-4 (the denoise/deblur levels are 1:1 by the SDK's own rule).
+ *
  * Requires cuda frames, so it needs --hwdec=nvdec and an OpenGL or Vulkan backend; mpv's CUDA
  * interop has no D3D11 path. With the copy-back decoders it will see software frames and pass
  * them through.
@@ -78,6 +87,11 @@
 #define NVCV_U8     1
 #define NVCV_CHUNKY 0
 #define NVCV_GPU    1
+// 10-bit packed RGB: one 32-bit word per pixel, R bits 0-9, G 10-19, B 20-29. The values are not in
+// any public header; NVCVImage.dll 1.3.0 accepts pixel format 13 only with component type 11 and
+// reports 4 bytes per pixel for it (probed 2026-10-03, F-R407).
+#define NVCV_RGB10A2 13
+#define NVCV_P32     11
 
 typedef struct NvCVImage {
     unsigned int width, height;
@@ -95,6 +109,7 @@ typedef void *NvVFX_Handle;
