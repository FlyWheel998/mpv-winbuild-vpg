@@ -192,8 +209,18 @@ static bool sdk_load(struct mp_filter *f, struct sdk *s, const char *dir)
 
 // ── filter ───────────────────────────────────────────────────────────────────
 
+enum { EFFECT_VSR = 0, EFFECT_TRUEHDR = 1 };
