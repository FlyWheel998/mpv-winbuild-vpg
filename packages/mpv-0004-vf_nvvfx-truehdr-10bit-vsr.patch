+    int contrast, saturation, middlegray, luminance;   // TrueHDR tunables (SDK ranges)
+    bool debanding;     // TrueHDR: false sets DebandingOff=1
+    bool enable;        // TrueHDR on/off without a graph rebuild
     char *libdir;
     bool sync;          // time the effect exactly, at the cost of a stall
     int log_every;
@@ -242,16 +269,18 @@ struct priv {
     AVBufferRef *frames_ref;
 
