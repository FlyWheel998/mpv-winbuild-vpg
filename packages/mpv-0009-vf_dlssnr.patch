+static const m_option_t vf_opts_fields[] = {
+    {"host", OPT_STRING(host), .flags = M_OPT_FILE},
+    {"enable", OPT_BOOL(enable)},
+    {"intensity", OPT_FLOAT(intensity), M_RANGE(0, 1)},
+    {"structure", OPT_FLOAT(structure)},
+    {"tone", OPT_FLOAT(tone)},
+    {"skin", OPT_FLOAT(skin)},
+    {"style", OPT_INT(style), M_RANGE(0, 2)},
+    {"auto-mask", OPT_BOOL(auto_mask)},
+    {"reset", OPT_CHOICE(reset, {"every", RESET_EVERY}, {"seek", RESET_SEEK},
+                                {"never", RESET_NEVER})},
+    {"hdr", OPT_CHOICE(hdr, {"auto", 0}, {"off", 1})},
+    {"hl", OPT_CHOICE(hl, {"keep", 0}, {"shape", 1})},
+    {"colour", OPT_CHOICE(colour, {"keep", 0}, {"model", 1})},
+    {"shadow", OPT_FLOAT(shadow), M_RANGE(0, 1)},
+    {"peak", OPT_FLOAT(peak), M_RANGE(0, 10000)},
+    {"downscale", OPT_INT(downscale), M_RANGE(0, 4320)},
+    {"identity", OPT_BOOL(identity)},
+    {"queue-depth", OPT_INT(queue_depth), M_RANGE(1, MAX_DEPTH - 1)},
+    {"skip-seek-pre-target", OPT_BOOL(skip_seek_pre_target)},
+    {0}
+};
+
+const struct mp_user_filter_entry vf_dlssnr = {
+    .desc = {
+        .description = "GPU-resident neural relight through a host library (CUDA)",
+        .name = "dlssnr",
+        .priv_size = sizeof(OPT_BASE_STRUCT),
+        .priv_defaults = &(const OPT_BASE_STRUCT) {
+            .enable = true,
+            .intensity = 1,
+            .structure = 1,
+            .tone = 1,
+            .skin = -1,
+            .auto_mask = true,
+            .reset = RESET_EVERY,
+            .shadow = 0.10,
+            .peak = 1000,
+            .queue_depth = 3,
+            .skip_seek_pre_target = true,
+        },
+        .options = vf_opts_fields,
+    },
+    .create = vf_dlssnr_create,
+};
